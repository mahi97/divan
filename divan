# Banner & Routing
# ═══════════════════════════════════════════════════════════════════════════════

banner() {
  echo -e "${BOLD}${CYAN}"
  echo "  ╺━┓╻╻ ╻┏━┓┏┓╻"
  echo "  ┏━╸┃┃┗┛┃┣━┫┃┗┫   Claude Code Super Collection"
  echo "  ╺━╸╹╹  ╹╹ ╹╹ ╹   v2.0.0"
  echo -e "${NC}"
}

usage() {
  banner
  echo "Usage: divan <command> [options]"
  echo ""
  echo "Commands:"
  echo "  init              Initialize a project with a profile"
  echo "  add <plugin|tag>  Add plugins to current project"
  echo "  remove <plugin>   Remove a plugin from current project"
  echo "  list              Browse all available plugins"
  echo "  profiles          List available profiles"
  echo "  status            Show current project's config"
  echo "  sync              Re-sync project from its profile"
  echo "  user-install      Install plugins at user level (~/.claude/)"
  echo ""
  echo "Examples:"
  echo "  divan init --profile web                      # init a web project"
  echo "  divan init --profile ml --target ~/research   # init elsewhere"
  echo "  divan add frontend-design                     # add a plugin"
  echo "  divan add ai-ml                               # add by tag"
  echo "  divan list --profile web                      # preview a profile"
  echo ""
}

# ─── Main ─────────────────────────────────────────────────────────────────────

[[ $# -eq 0 ]] && { usage; exit 0; }

CMD="$1"; shift

case "$CMD" in
  _install)        _do_install "$@" ;;
  _uninstall)      _do_uninstall ;;
  init)            cmd_init "$@" ;;
  add)             [[ $# -ge 1 ]] || { log_err "Usage: divan add <plugin|tag>"; exit 1; }; cmd_add "$@" ;;
  remove|rm)       [[ $# -ge 1 ]] || { log_err "Usage: divan remove <plugin>"; exit 1; }; cmd_remove "$@" ;;
  list|ls)         cmd_list "$@" ;;
  profiles)        cmd_profiles ;;
  status|st)       cmd_status ;;
  sync)            cmd_sync ;;
  user-install)    cmd_user_install "$@" ;;
  help|-h|--help)  usage ;;
  *)               log_err "Unknown command: $CMD"; usage; exit 1 ;;
esac
