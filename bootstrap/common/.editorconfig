# EditorConfig — https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab
